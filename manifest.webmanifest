{
  "name": "Videoteca — tu biblioteca de vídeos",
  "short_name": "Videoteca",
  "description": "Guarda y organiza vídeos de YouTube, TikTok, Instagram y más, con miniaturas, etiquetas automáticas y búsqueda potente. Todo en tu propio dispositivo.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0d0f14",
  "theme_color": "#0d0f14",
  "lang": "es",
  "dir": "ltr",
  "categories": ["productivity", "utilities", "entertainment"],
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Añadir vídeos", "short_name": "Añadir", "url": "./?action=add", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] },
    { "name": "Favoritos", "short_name": "Favoritos", "url": "./?q=is%3Afavorito" },
    { "name": "Pendientes de ver", "short_name": "Pendientes", "url": "./?q=is%3Apendiente" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
