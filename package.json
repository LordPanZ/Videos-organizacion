{
  "name": "videoteca",
  "productName": "Videoteca",
  "version": "1.0.0",
  "description": "Organizador y biblioteca local de videos de YouTube, TikTok, Instagram, Vimeo y +1000 plataformas. Miniaturas, etiquetado automatico, colecciones inteligentes y campos personalizados ilimitados.",
  "author": {
    "name": "LordPanZ",
    "email": "urkocasas@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build:web": "vite build --config vite.web.config.ts",
    "build:single": "vite build --config vite.single.config.ts && node scripts/build-single.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.3"
  }
}
